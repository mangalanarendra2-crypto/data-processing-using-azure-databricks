{
  "name": "retail-sales-medallion-pipeline",
  "comment": "Bronze -> Silver -> Gold pipeline for retail sales data. Import via Databricks Jobs UI ('Create Job' -> JSON) or the Databricks CLI: `databricks jobs create --json @databricks_job.json`",
  "tags": {
    "project": "data-processing-databricks",
    "environment": "dev"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 2,
        "spark_conf": {
          "spark.sql.shuffle.partitions": "auto"
        },
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE",
          "first_on_demand": 1
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_ingestion",
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/your-org/data-processing-databricks/notebooks/01_bronze_ingestion",
        "base_parameters": {
          "raw_path": "/Volumes/main/retail_sales/raw",
          "bronze_path": "/Volumes/main/retail_sales/bronze"
        }
      },
      "timeout_seconds": 3600,
      "max_retries": 1
    },
    {
      "task_key": "silver_transformation",
      "job_cluster_key": "etl_cluster",
      "depends_on": [{ "task_key": "bronze_ingestion" }],
      "notebook_task": {
        "notebook_path": "/Repos/your-org/data-processing-databricks/notebooks/02_silver_transformation",
        "base_parameters": {
          "bronze_path": "/Volumes/main/retail_sales/bronze",
          "silver_path": "/Volumes/main/retail_sales/silver"
        }
      },
      "timeout_seconds": 3600,
      "max_retries": 1
    },
    {
      "task_key": "gold_aggregation",
      "job_cluster_key": "etl_cluster",
      "depends_on": [{ "task_key": "silver_transformation" }],
      "notebook_task": {
        "notebook_path": "/Repos/your-org/data-processing-databricks/notebooks/03_gold_aggregation",
        "base_parameters": {
          "silver_path": "/Volumes/main/retail_sales/silver",
          "gold_path": "/Volumes/main/retail_sales/gold"
        }
      },
      "timeout_seconds": 3600,
      "max_retries": 1
    }
  ],
  "email_notifications": {
    "on_failure": ["your-team-alias@example.com"]
  }
}
